{### Extends #}
{% extends '_layouts/main.twig' %}

{### Permissions #}

{### Macros #}

{### Data logic #}

{### Blocks #}
{% block content %}
    {% if entry.type.handle == 'events' %}
        {% include '_pages/events.twig' %}
    {% else %}
        <section class="container mb-12 lg:mb-32">
            <h1 class="text-white text-5xl md:text-7xl xl:text-9xl" >
            {% if entry.headline is defined and entry.headline|length %}
                {{ entry.headline|replace({'[br]': '<br class="hidden md:inline"/>'})|raw }}
            {% else %}
              {{ entry.title }}
            {% endif %}
            </h1>
        </section>
        <div class="space-y-12 md:space-y-16 lg:space-y-48">
        {# Element partials only see what is passed in, so hand over the FormsController's
         # validation state, otherwise a failed submission shows no errors. #}
        {% set formState = { formErrors: formErrors ?? null, formValues: formValues ?? null } %}
        {% for block in entry.contentMatrix.eagerly().all()  %}
            {{ block.render(formState) }}
        {% endfor %}
        </div>
    {% endif %}
{% endblock %}
